{
	"name": "nice-audio-player",
	"productName": "Nice Audio Player",
	"private": true,
	"packageManager": "pnpm@12.3.4",
	"engines": {
		"node": "^24.21.0"
	},
	"main": "build/electron/main.cjs",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "pnpm run dev:prepare && concurrently --kill-others --success first --names renderer,electron \"pnpm run dev:renderer\" \"pnpm run dev:electron:wait\"",
		"dev:prepare": "pnpm run build:electron",
		"dev:renderer": "ng serve --host 127.0.0.1 --port 5173",
		"dev:electron": "cross-env NICE_AUDIO_PLAYER_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
		"dev:electron:wait": "wait-on --timeout 15000 http://127.0.0.1:5173/ && pnpm run dev:electron",
		"start": "electron .",
		"start:build": "pnpm run build && pnpm run start",
		"build": "pnpm run bindings:generate && pnpm run build:renderer && pnpm run build:electron && pnpm run build:backend && pnpm run build:runtime",
		"build:renderer": "pnpm fonts:check && ng build",
		"build:electron": "node scripts/build-electron.mjs",
		"build:backend": "cargo build --release --manifest-path backend/Cargo.toml && node scripts/stage-backend.mjs",
		"build:runtime": "node scripts/stage-runtime.mjs",
		"bindings:generate": "cargo run --manifest-path backend/Cargo.toml --bin generate-bindings",
		"bindings:check": "cargo run --manifest-path backend/Cargo.toml --bin generate-bindings -- --check",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"check:renderer": "ng build --configuration development",
		"lint:code": "eslint .",
		"lint:styles": "stylelint \"src/**/*.css\"",
		"lint": "pnpm run lint:code && pnpm run lint:styles",
		"test": "pnpm run test:unit && pnpm run test:e2e && pnpm run rust:test",
		"test:unit": "ng test --watch=false",
		"test:e2e": "pnpm run test:e2e:renderer && pnpm run test:e2e:electron",
		"test:e2e:renderer": "playwright test --project=renderer",
		"test:e2e:electron": "pnpm run test:e2e:electron:prepare && playwright test --project=electron",
		"test:e2e:electron:prepare": "pnpm run build:electron",
		"test:e2e:ui": "playwright test --project=renderer --ui",
		"test:e2e:debug": "playwright test --project=renderer --debug",
		"test:e2e:electron:debug": "pnpm run test:e2e:electron:prepare && playwright test --project=electron --debug",
		"test:renderer": "ng serve --host 127.0.0.1 --port 4200",
		"rust:check": "cargo check --manifest-path backend/Cargo.toml",
		"rust:format:check": "cargo fmt --manifest-path backend/Cargo.toml -- --check",
		"rust:lint": "cargo clippy --manifest-path backend/Cargo.toml --all-targets -- -D warnings",
		"rust:test": "cargo test --manifest-path backend/Cargo.toml",
		"check": "pnpm run bindings:check && pnpm run typecheck && pnpm run check:renderer && pnpm run format:check && pnpm run lint",
		"verify": "pnpm run check && pnpm run rust:format:check && pnpm run rust:lint && pnpm run test",
		"validate": "pnpm run verify && pnpm run build",
		"fonts:download": "node scripts/fonts.mjs download",
		"fonts:check": "node scripts/fonts.mjs check",
		"snapshot": "python scripts/create-project-snapshot.py",
		"forge:package": "electron-forge package",
		"forge:make": "electron-forge make",
		"forge:publish": "electron-forge publish"
	},
	"devDependencies": {
		"@angular/build": "^22.1.7",
		"@angular/cli": "^22.1.7",
		"@angular/compiler-cli": "^22.1.0",
		"@axe-core/playwright": "4.13.0",
		"@electron-forge/cli": "^7.11.2",
		"@electron-forge/maker-squirrel": "^7.11.2",
		"@electron-forge/shared-types": "^7.11.2",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/noto-sans-jp": "^5.2.7",
		"@playwright/test": "^1.60.0",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^24",
		"angular-eslint": "22.5.0",
		"concurrently": "^10.0.5",
		"cross-env": "^10.1.0",
		"electron": "44.1.1",
		"esbuild": "0.28.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-tailwindcss": "^4.4.0",
		"globals": "^17.6.0",
		"jsdom": "^28.1.0",
		"playwright": "^1.60.0",
		"postcss": "^8.5.28",
		"prettier": "^3.8.3",
		"prettier-plugin-tailwindcss": "0.8.1",
		"stylelint": "^17.14.1",
		"stylelint-config-standard": "^40.0.0",
		"tailwindcss": "^4.3.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.60.1",
		"vitest": "^4.1.8",
		"wait-on": "^9.1.0"
	},
	"dependencies": {
		"@angular/aria": "22.1.6",
		"@angular/cdk": "22.1.6",
		"@angular/common": "^22.1.0",
		"@angular/compiler": "^22.1.0",
		"@angular/core": "^22.1.0",
		"@angular/forms": "^22.1.0",
		"@angular/platform-browser": "^22.1.0",
		"@angular/router": "^22.1.0",
		"@lucide/angular": "1.43.0",
		"electron-squirrel-startup": "^1.0.1",
		"gsap": "^3.15.0",
		"rxjs": "~7.8.0",
		"tslib": "^2.3.0"
	}
}
