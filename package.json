{
  "name": "nice-audio-player",
  "version": "0.0.1",
  "private": true,
  "description": "A native desktop audio player for Windows.",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "tauri dev",
    "preview": "vite preview",
    "build": "pnpm fonts:ensure && vite build",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --output human && tsc -b tsconfig.tools.json tests/tsconfig.json tests-app/tsconfig.json --pretty false",
    "lint": "oxlint --type-aware src tests tests-app vite.config.ts playwright.config.ts",
    "format": "oxfmt . && prettier --write \"src/**/*.svelte\"",
    "format:check": "oxfmt --check . && prettier --check \"src/**/*.svelte\"",
    "test": "vitest run && pnpm test:native",
    "test:renderer": "vitest run --project renderer",
    "test:shared": "vitest run --project shared",
    "test:native": "cargo test --workspace",
    "test:e2e": "pnpm test:renderer:e2e",
    "test:renderer:e2e": "playwright test --project renderer",
    "test:e2e:app": "wdio run tests-app/wdio.conf.ts",
    "check": "pnpm fonts:check && pnpm format:check && pnpm lint && pnpm typecheck",
    "bindings": "cargo run --bin export-bindings",
    "check:native": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings",
    "fonts:check": "node scripts/fonts.mjs check",
    "fonts:ensure": "node scripts/fonts.mjs ensure",
    "fonts:download": "node scripts/fonts.mjs download",
    "package": "pnpm fonts:check && tauri build",
    "validate": "pnpm fonts:ensure && pnpm check && pnpm check:native && pnpm test && pnpm test:e2e",
    "prepare": "svelte-kit sync || echo \"\""
  },
  "dependencies": {
    "@tanstack/svelte-query": "^6.3.6",
    "@tanstack/svelte-virtual": "^3.13.48",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "cn": "0.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lucide/svelte": "^1.61.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@wdio/cli": "^10.1.0",
    "@wdio/globals": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/mocha-framework": "^10.1.0",
    "@wdio/spec-reporter": "^10.1.0",
    "@wdio/tauri-plugin": "^1.5.1",
    "@wdio/tauri-service": "^1.5.1",
    "@wdio/types": "^10.1.0",
    "bits-ui": "^2.20.2",
    "happy-dom": "^21.0.4",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "shadcn": "^4.22.1",
    "shadcn-svelte": "^1.7.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "webdriverio": "^10.1.0"
  },
  "engines": {
    "node": "^24.22.1"
  },
  "packageManager": "pnpm@12.14.0",
  "productName": "Nice Audio Player"
}
