{
  "name": "nice-audio-player",
  "version": "0.0.1",
  "private": true,
  "description": "A native desktop audio player for Windows.",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "preview": "vite preview",
    "build": "pnpm fonts:ensure && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint --type-aware src tests vite.config.ts playwright.config.ts wdio.conf.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run && pnpm test:native",
    "test:renderer": "vitest run --project renderer",
    "test:shared": "vitest run --project shared",
    "test:native": "cargo test --manifest-path backend/Cargo.toml && cargo test --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "pnpm test:renderer:e2e && pnpm test:tauri:e2e",
    "test:renderer:e2e": "playwright test --project renderer",
    "test:tauri:e2e": "pnpm build && cargo build --manifest-path src-tauri/Cargo.toml && wdio run wdio.conf.ts",
    "check": "pnpm typecheck && pnpm format:check && pnpm lint && pnpm fonts:check",
    "bindings": "cargo run --manifest-path src-tauri/Cargo.toml --bin export-bindings",
    "bindings:check": "cargo run --manifest-path src-tauri/Cargo.toml --bin export-bindings -- --check",
    "check:native": "pnpm bindings:check && cargo fmt --manifest-path backend/Cargo.toml -- --check && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path backend/Cargo.toml --all-targets -- -D warnings && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "fonts:check": "node scripts/fonts.mjs check",
    "fonts:ensure": "node scripts/fonts.mjs ensure",
    "fonts:download": "node scripts/fonts.mjs download",
    "package": "pnpm fonts:check && tauri build",
    "validate": "pnpm fonts:ensure && pnpm check && pnpm check:native && pnpm test && pnpm test:e2e && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-router": "^1.167.3",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.18",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "0.3.0",
    "lucide-react": "^0.575.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/router-plugin": "^1.168.40",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@wdio/cli": "^9.0.0",
    "@wdio/globals": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "@wdio/tauri-service": "^1.3.0",
    "jsdom": "^30.1.0",
    "oxfmt": "^0.19.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.60.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.8",
    "webdriverio": "^9.0.0"
  },
  "engines": {
    "node": "^24.21.0"
  },
  "packageManager": "pnpm@12.4.1",
  "productName": "Nice Audio Player"
}
