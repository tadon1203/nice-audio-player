{
  "name": "nice-audio-player",
  "version": "0.0.1",
  "private": true,
  "description": "A native desktop audio player for Windows.",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "preview": "vite preview",
    "build": "pnpm fonts:ensure && vite build",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --output human && tsc -b tsconfig.tools.json tests/tsconfig.json tests-app/tsconfig.json --pretty false",
    "lint": "oxlint --type-aware src tests tests-app vite.config.ts playwright.config.ts",
    "format": "oxfmt . && prettier --write \"src/**/*.svelte\"",
    "format:check": "oxfmt --check . && prettier --check \"src/**/*.svelte\"",
    "test": "vitest run && pnpm test:native",
    "test:renderer": "vitest run --project renderer",
    "test:shared": "vitest run --project shared",
    "test:native": "cargo test --workspace",
    "test:e2e": "pnpm test:renderer:e2e",
    "test:renderer:e2e": "playwright test --project renderer",
    "test:e2e:app": "wdio run tests-app/wdio.conf.ts",
    "check": "pnpm typecheck && pnpm format:check && pnpm lint && pnpm fonts:check",
    "bindings": "cargo run --bin export-bindings",
    "bindings:check": "cargo run --bin export-bindings -- --check",
    "check:native": "pnpm bindings:check && cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings",
    "tickets": "node scripts/tickets.mjs",
    "fonts:check": "node scripts/fonts.mjs check",
    "fonts:ensure": "node scripts/fonts.mjs ensure",
    "fonts:download": "node scripts/fonts.mjs download",
    "package": "pnpm fonts:check && tauri build",
    "validate": "pnpm fonts:ensure && pnpm check && pnpm check:native && pnpm test && pnpm test:e2e && pnpm build",
    "prepare": "svelte-kit sync || echo \"\""
  },
  "dependencies": {
    "@tanstack/svelte-query": "^6.3.0",
    "@tanstack/svelte-virtual": "^3.13.39",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "cn": "0.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lucide/svelte": "^1.49.0",
    "@playwright/test": "^1.60.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^24.13.3",
    "@types/pngjs": "^6.0.5",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "@wdio/tauri-plugin": "^1.4.0",
    "@wdio/tauri-service": "^1.4.0",
    "@wdio/types": "^9.32.0",
    "bits-ui": "^2.18.0",
    "jsdom": "^30.1.0",
    "oxfmt": "^0.19.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.60.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "shadcn": "^4.0.0",
    "shadcn-svelte": "^1.7.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.8",
    "webdriverio": "^9.32.0"
  },
  "engines": {
    "node": "^24.21.0"
  },
  "packageManager": "pnpm@12.4.1",
  "productName": "Nice Audio Player"
}
