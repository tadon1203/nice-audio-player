{
	"name": "nice-audio-player",
	"productName": "Nice Audio Player",
	"private": true,
	"packageManager": "pnpm@12.3.4",
	"engines": {
		"node": "^24.21.0"
	},
	"main": "build/electron/main.cjs",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "pnpm build:electron && concurrently --kill-others --success first --names renderer,electron \"pnpm dev:renderer\" \"wait-on --timeout 15000 http://127.0.0.1:5173/ && pnpm dev:electron\"",
		"dev:renderer": "ng serve --host 127.0.0.1 --port 5173",
		"dev:electron": "cross-env NICE_AUDIO_PLAYER_DEV_SERVER_URL=http://127.0.0.1:5173 electron build/electron/main.cjs",
		"build:electron": "node scripts/build-electron.mjs",
		"build:renderer": "pnpm fonts:check && ng build",
		"fonts:download": "node scripts/fonts.mjs download",
		"fonts:check": "node scripts/fonts.mjs check",
		"build:backend": "cargo build --release --manifest-path backend/Cargo.toml && node scripts/stage-backend.mjs",
		"generate:bindings": "cargo run --manifest-path backend/Cargo.toml --bin generate-bindings",
		"check:bindings": "cargo run --manifest-path backend/Cargo.toml --bin generate-bindings -- --check",
		"electron": "pnpm build && electron build/electron/main.cjs",
		"build": "pnpm generate:bindings && pnpm build:renderer && pnpm build:electron && pnpm build:backend && pnpm stage:runtime",
		"stage:runtime": "node scripts/stage-runtime.mjs",
		"forge:package": "electron-forge package",
		"forge:make": "electron-forge make",
		"forge:publish": "electron-forge publish",
		"check": "ng build --configuration development",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint:format": "prettier . --check",
		"lint:code": "eslint .",
		"lint:styles": "stylelint \"src/**/*.css\"",
		"lint": "pnpm lint:format && pnpm lint:code && pnpm lint:styles",
		"format": "prettier . --write",
		"test:e2e": "playwright test",
		"test:unit": "ng test --watch=false",
		"test": "pnpm test:unit && pnpm test:e2e",
		"rust:check": "cargo check --manifest-path backend/Cargo.toml",
		"rust:clippy": "cargo clippy --manifest-path backend/Cargo.toml --all-targets -- -D warnings",
		"rust:test": "cargo test --manifest-path backend/Cargo.toml",
		"rust:fmt": "cargo fmt --manifest-path backend/Cargo.toml -- --check",
		"verify": "pnpm check:bindings && pnpm typecheck && pnpm check && pnpm lint && pnpm rust:fmt && pnpm rust:clippy && pnpm rust:test && pnpm test",
		"validate": "pnpm verify && pnpm build"
	},
	"devDependencies": {
		"@angular/build": "^22.1.7",
		"@angular/cli": "^22.1.7",
		"@angular/compiler-cli": "^22.1.0",
		"@electron-forge/cli": "^7.11.2",
		"@electron-forge/maker-squirrel": "^7.11.2",
		"@electron-forge/shared-types": "^7.11.2",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/noto-sans-jp": "^5.2.7",
		"@playwright/test": "^1.60.0",
		"@axe-core/playwright": "4.13.0",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^24",
		"angular-eslint": "22.5.0",
		"concurrently": "^10.0.5",
		"cross-env": "^10.1.0",
		"electron": "44.1.1",
		"esbuild": "0.28.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-tailwindcss": "^4.4.0",
		"globals": "^17.6.0",
		"jsdom": "^28.1.0",
		"playwright": "^1.60.0",
		"postcss": "^8.5.28",
		"prettier": "^3.8.3",
		"prettier-plugin-tailwindcss": "0.8.1",
		"stylelint": "^17.14.1",
		"stylelint-config-standard": "^40.0.0",
		"tailwindcss": "^4.3.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.60.1",
		"vitest": "^4.1.8",
		"wait-on": "^9.1.0"
	},
	"dependencies": {
		"@angular/common": "^22.1.0",
		"@angular/compiler": "^22.1.0",
		"@angular/core": "^22.1.0",
		"@angular/forms": "^22.1.0",
		"@angular/platform-browser": "^22.1.0",
		"@angular/router": "^22.1.0",
		"electron-squirrel-startup": "^1.0.1",
		"gsap": "^3.15.0",
		"rxjs": "~7.8.0",
		"tslib": "^2.3.0"
	}
}
