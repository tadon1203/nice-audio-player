{
	"name": "nice-audio-player",
	"productName": "Nice Audio Player",
	"description": "A native desktop audio player for Windows.",
	"private": true,
	"packageManager": "pnpm@12.4.1",
	"engines": {
		"node": "^24.21.0"
	},
	"main": "build/electron/main.cjs",
	"version": "0.0.1",
	"type": "module",
	"napi": {
		"binaryName": "nice_audio_player_backend",
		"constEnum": false,
		"runtimeStringEnum": false
	},
	"scripts": {
		"check:ts": "tsc -p tsconfig.json --noEmit",
		"check:format": "prettier . --check",
		"check:lint": "pnpm lint",
		"check:rust": "cargo fmt --manifest-path backend/Cargo.toml -- --check && cargo clippy --manifest-path backend/Cargo.toml --all-targets -- -D warnings",
		"test:angular": "ng test --watch=false",
		"test:node": "vitest run tests",
		"test:rust": "cargo test --manifest-path backend/Cargo.toml",
		"test:e2e": "playwright test",
		"build:native": "napi build --manifest-path backend/Cargo.toml --target x86_64-pc-windows-msvc --platform --output-dir build/native --js index.cjs --dts ../../shared/native-backend.d.ts -- --locked",
		"build:native:release": "napi build --manifest-path backend/Cargo.toml --target x86_64-pc-windows-msvc --platform --release --output-dir build/native --js index.cjs --dts ../../shared/native-backend.d.ts -- --locked",
		"build:electron:main": "esbuild electron/main/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=build/electron/main.cjs",
		"build:electron:preload": "esbuild electron/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=build/electron/preload/index.cjs",
		"build:electron": "concurrently \"pnpm build:electron:main\" \"pnpm build:electron:preload\"",
		"build:runtime": "concurrently \"pnpm build:native\" \"pnpm build:electron\"",
		"build:renderer": "ng build",
		"dev:renderer": "ng serve --host 127.0.0.1 --port 4200",
		"dev:desktop": "nodemon --watch electron --watch backend/src --watch backend/Cargo.toml --watch backend/build.rs --ext ts,rs,toml --exec \"pnpm build:runtime && wait-on http://127.0.0.1:4200 && cross-env NICE_AUDIO_PLAYER_DEV_SERVER_URL=http://127.0.0.1:4200 electron .\"",
		"dev": "concurrently -k \"pnpm dev:renderer\" \"pnpm dev:desktop\"",
		"start": "electron .",
		"build": "node scripts/fonts.mjs check && concurrently \"pnpm build:renderer\" \"pnpm build:electron\" \"pnpm build:native:release\"",
		"package": "pnpm build && electron-forge package",
		"release": "pnpm build && electron-forge make",
		"bindings:generate": "pnpm build:native",
		"bindings:check": "pnpm build:native && git diff --exit-code -- shared/native-backend.d.ts",
		"test": "pnpm test:angular && pnpm test:node && pnpm test:rust && pnpm test:e2e",
		"lint": "node scripts/check-design-tokens.mjs && eslint . && stylelint \"src/**/*.css\"",
		"validate": "pnpm bindings:check && pnpm check:ts && pnpm check:format && pnpm check:lint && pnpm check:rust && pnpm test && pnpm build",
		"format": "prettier . --write",
		"fonts": "node scripts/fonts.mjs",
		"snapshot": "python scripts/create-project-snapshot.py"
	},
	"devDependencies": {
		"@napi-rs/cli": "3.9.0",
		"@angular/build": "^22.1.7",
		"@angular/cli": "^22.1.7",
		"@angular/compiler-cli": "^22.1.0",
		"@axe-core/playwright": "4.13.0",
		"@electron-forge/cli": "^7.11.2",
		"@electron-forge/maker-squirrel": "^7.11.2",
		"@electron-forge/shared-types": "^7.11.2",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/noto-sans-jp": "^5.2.7",
		"@playwright/test": "^1.60.0",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^24",
		"angular-eslint": "22.5.0",
		"concurrently": "^10.0.5",
		"cross-env": "^10.1.0",
		"electron": "44.1.1",
		"esbuild": "0.28.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-tailwindcss": "^4.4.0",
		"globals": "^17.6.0",
		"jsdom": "^28.1.0",
		"nodemon": "3.1.14",
		"playwright": "^1.60.0",
		"postcss": "^8.5.28",
		"prettier": "^3.8.3",
		"prettier-plugin-tailwindcss": "0.8.1",
		"stylelint": "^17.14.1",
		"stylelint-config-standard": "^40.0.0",
		"tailwindcss": "^4.3.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.60.1",
		"vitest": "^4.1.8",
		"wait-on": "^9.1.0"
	},
	"dependencies": {
		"@angular/aria": "22.1.6",
		"@angular/cdk": "22.1.6",
		"@angular/common": "^22.1.0",
		"@angular/compiler": "^22.1.0",
		"@angular/core": "^22.1.0",
		"@angular/forms": "^22.1.0",
		"@angular/platform-browser": "^22.1.0",
		"@angular/router": "^22.1.0",
		"@lucide/angular": "1.43.0",
		"electron-squirrel-startup": "^1.0.1",
		"rxjs": "~7.8.0",
		"tslib": "^2.3.0"
	}
}
