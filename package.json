{
  "name": "nice-audio-player",
  "version": "0.0.1",
  "private": true,
  "description": "A native desktop audio player for Windows.",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "pnpm build:native && electron-vite dev --watch",
    "preview": "pnpm build:native:release && electron-vite preview",
    "build": "pnpm fonts:ensure && pnpm build:native:release && electron-vite build",
    "build:native": "napi build --manifest-path backend/Cargo.toml --target x86_64-pc-windows-msvc --platform --output-dir build/native --js index.cjs --dts native-backend.d.ts -- --locked",
    "build:native:release": "napi build --release --manifest-path backend/Cargo.toml --target x86_64-pc-windows-msvc --platform --output-dir build/native --js index.cjs --dts native-backend.d.ts -- --locked",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint --type-aware src tests electron.vite.config.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run && pnpm test:native",
    "test:renderer": "vitest run --project renderer",
    "test:main": "vitest run --project main",
    "test:shared": "vitest run --project shared",
    "test:native": "cargo test --manifest-path backend/Cargo.toml",
    "test:e2e": "pnpm build:native:release && electron-vite build && playwright test",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "check": "pnpm typecheck && pnpm format:check && pnpm lint && pnpm fonts:check",
    "check:native": "cargo fmt --manifest-path backend/Cargo.toml -- --check && cargo clippy --manifest-path backend/Cargo.toml --all-targets -- -D warnings",
    "bindings:update": "pnpm build:native && node scripts/bindings.mjs update",
    "bindings:check": "pnpm build:native && node scripts/bindings.mjs check",
    "fonts:check": "node scripts/fonts.mjs check",
    "fonts:ensure": "node scripts/fonts.mjs ensure",
    "fonts:download": "node scripts/fonts.mjs download",
    "package": "pnpm build && electron-builder",
    "validate": "pnpm fonts:ensure && pnpm check && pnpm check:native && pnpm bindings:check && pnpm test && pnpm test:e2e && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-router": "^1.167.3",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.18",
    "class-variance-authority": "^0.7.1",
    "cn": "0.3.0",
    "lucide-react": "^0.575.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@napi-rs/cli": "3.9.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/router-plugin": "^1.168.40",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.1.1",
    "electron-builder": "26.16.1",
    "electron-vite": "6.0.0-beta.1",
    "jsdom": "^30.1.0",
    "oxfmt": "^0.19.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.60.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": "^24.21.0"
  },
  "packageManager": "pnpm@12.4.1",
  "productName": "Nice Audio Player"
}
