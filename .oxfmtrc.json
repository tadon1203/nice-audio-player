{
  "$schema": "https://oxc.rs/schemas/oxfmt-config.schema.json",
  "printWidth": 100,
  "singleQuote": false,
  "semi": true,
  "tabWidth": 2,
  "useTabs": false,
  "trailingComma": "all",
  "ignorePatterns": [
    "dist/**",
    "out/**",
    "build/**",
    "backend/target/**",
    "src-tauri/target/**",
    "test-results/**",
    "playwright-report/**",
    "project_snapshot.zip",
    "src/lib/native/bindings.ts",
    ".svelte-kit/**",
    "release/**",
    "src/lib/ui/shadcn/**"
  ]
}
