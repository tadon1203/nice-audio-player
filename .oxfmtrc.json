{
  "$schema": "https://oxc.rs/schemas/oxfmt-config.schema.json",
  "printWidth": 100,
  "singleQuote": false,
  "semi": true,
  "tabWidth": 2,
  "useTabs": false,
  "trailingComma": "all",
  "ignorePatterns": [
    "dist/**",
    "out/**",
    "build/**",
    "backend/target/**",
    "src-tauri/target/**",
    "test-results/**",
    "playwright-report/**",
    "project_snapshot.zip",
    "src/shared/ipc/bindings.ts",
    "release/**",
    "src/renderer/shared/hooks/use-mobile.ts",
    "src/app/renderer/routeTree.gen.ts",
    "src/renderer/shared/ui/shadcn/alert-dialog.tsx",
    "src/renderer/shared/ui/shadcn/alert.tsx",
    "src/renderer/shared/ui/shadcn/button-group.tsx",
    "src/renderer/shared/ui/shadcn/button.tsx",
    "src/renderer/shared/ui/shadcn/checkbox.tsx",
    "src/renderer/shared/ui/shadcn/dialog.tsx",
    "src/renderer/shared/ui/shadcn/empty.tsx",
    "src/renderer/shared/ui/shadcn/field.tsx",
    "src/renderer/shared/ui/shadcn/input.tsx",
    "src/renderer/shared/ui/shadcn/item.tsx",
    "src/renderer/shared/ui/shadcn/label.tsx",
    "src/renderer/shared/ui/shadcn/progress.tsx",
    "src/renderer/shared/ui/shadcn/scroll-area.tsx",
    "src/renderer/shared/ui/shadcn/select.tsx",
    "src/renderer/shared/ui/shadcn/separator.tsx",
    "src/renderer/shared/ui/shadcn/sheet.tsx",
    "src/renderer/shared/ui/shadcn/sidebar.tsx",
    "src/renderer/shared/ui/shadcn/skeleton.tsx",
    "src/renderer/shared/ui/shadcn/slider.tsx",
    "src/renderer/shared/ui/shadcn/spinner.tsx",
    "src/renderer/shared/ui/shadcn/table.tsx",
    "src/renderer/shared/ui/shadcn/toggle-group.tsx",
    "src/renderer/shared/ui/shadcn/toggle.tsx",
    "src/renderer/shared/ui/shadcn/tooltip.tsx",
    "src/renderer/shared/ui/shadcn/input-group.tsx",
    "src/renderer/shared/ui/shadcn/textarea.tsx"
  ]
}
