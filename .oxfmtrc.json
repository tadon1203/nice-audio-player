{
  "$schema": "https://oxc.rs/schemas/oxfmt-config.schema.json",
  "printWidth": 100,
  "singleQuote": false,
  "semi": true,
  "tabWidth": 2,
  "useTabs": false,
  "trailingComma": "all",
  "ignorePatterns": [
    "dist/**",
    "out/**",
    "build/**",
    "backend/target/**",
    "test-results/**",
    "playwright-report/**",
    "project_snapshot.zip",
    "src/main/shared/native-backend/native-backend.d.ts",
    "release/**",
    "src/renderer/shared/hooks/use-mobile.ts",
    "src/app/renderer/routeTree.gen.ts",
    "src/renderer/shared/ui/alert-dialog.tsx",
    "src/renderer/shared/ui/alert.tsx",
    "src/renderer/shared/ui/button-group.tsx",
    "src/renderer/shared/ui/button.tsx",
    "src/renderer/shared/ui/checkbox.tsx",
    "src/renderer/shared/ui/dialog.tsx",
    "src/renderer/shared/ui/empty.tsx",
    "src/renderer/shared/ui/field.tsx",
    "src/renderer/shared/ui/input.tsx",
    "src/renderer/shared/ui/item.tsx",
    "src/renderer/shared/ui/label.tsx",
    "src/renderer/shared/ui/progress.tsx",
    "src/renderer/shared/ui/scroll-area.tsx",
    "src/renderer/shared/ui/select.tsx",
    "src/renderer/shared/ui/separator.tsx",
    "src/renderer/shared/ui/sheet.tsx",
    "src/renderer/shared/ui/sidebar.tsx",
    "src/renderer/shared/ui/skeleton.tsx",
    "src/renderer/shared/ui/slider.tsx",
    "src/renderer/shared/ui/spinner.tsx",
    "src/renderer/shared/ui/table.tsx",
    "src/renderer/shared/ui/toggle-group.tsx",
    "src/renderer/shared/ui/toggle.tsx",
    "src/renderer/shared/ui/tooltip.tsx"
  ]
}
