{
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "main-capability",
        {
          "identifier": "e2e-capability",
          "description": "WebdriverIO access for the app-level E2E build only.",
          "windows": ["main"],
          "permissions": ["core:window:default", "wdio:default", "wdio-webdriver:default"]
        }
      ]
    }
  }
}
