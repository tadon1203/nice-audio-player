{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Nice Audio Player: dev",
			"type": "process",
			"command": "node",
			"args": ["scripts/dev.mjs"],
			"options": { "cwd": "${workspaceFolder}" },
			"problemMatcher": []
		},
		{
			"label": "Nice Audio Player: build",
			"type": "shell",
			"command": "pnpm.cmd",
			"args": ["build"],
			"options": { "cwd": "${workspaceFolder}" },
			"group": { "kind": "build", "isDefault": true },
			"problemMatcher": []
		},
		{
			"label": "Nice Audio Player: test",
			"type": "shell",
			"command": "pnpm.cmd",
			"args": ["test"],
			"options": { "cwd": "${workspaceFolder}" },
			"group": { "kind": "test", "isDefault": true },
			"problemMatcher": []
		},
		{
			"label": "Nice Audio Player: validate",
			"type": "shell",
			"command": "pnpm.cmd",
			"args": ["validate"],
			"options": { "cwd": "${workspaceFolder}" },
			"problemMatcher": []
		},
		{
			"label": "Nice Audio Player: update bindings",
			"type": "shell",
			"command": "pnpm.cmd",
			"args": ["bindings:update"],
			"options": { "cwd": "${workspaceFolder}" },
			"problemMatcher": []
		},
		{
			"label": "Nice Audio Player: check bindings",
			"type": "shell",
			"command": "pnpm.cmd",
			"args": ["bindings:check"],
			"options": { "cwd": "${workspaceFolder}" },
			"problemMatcher": []
		}
	]
}
