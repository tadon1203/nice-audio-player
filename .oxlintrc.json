{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/app/renderer/routes/**/*.tsx"],
      "rules": {
        "react/only-export-components": [
          "warn",
          {
            "allowConstantExport": true,
            "allowExportNames": ["Route"]
          }
        ]
      }
    },
    {
      "files": [
        "src/renderer/shared/ui/shadcn/button.tsx",
        "src/renderer/shared/ui/shadcn/button-group.tsx"
      ],
      "rules": {
        "react/only-export-components": "off"
      }
    },
    {
      "files": ["src/renderer/widgets/track-table/track-table.tsx"],
      "rules": {
        "react/incompatible-library": "off"
      }
    }
  ],
  "ignorePatterns": [
    "dist",
    "src/shared/ipc/bindings.ts",
    "out",
    "build",
    "node_modules",
    "playwright-report",
    "test-results",
    "release",
    "src/app/renderer/routeTree.gen.ts"
  ]
}
