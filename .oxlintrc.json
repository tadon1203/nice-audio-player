{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/entities", "@/entities/**"],
                "message": "FSD: `shared` must not import from `entities` (upper layer)."
              },
              {
                "group": ["@/features", "@/features/**"],
                "message": "FSD: `shared` must not import from `features` (upper layer)."
              },
              {
                "group": ["@/widgets", "@/widgets/**"],
                "message": "FSD: `shared` must not import from `widgets` (upper layer)."
              },
              {
                "group": ["@/pages", "@/pages/**"],
                "message": "FSD: `shared` must not import from `pages` (upper layer)."
              },
              {
                "group": ["@/app", "@/app/**"],
                "message": "FSD: `shared` must not import from `app` (upper layer)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/entities/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features", "@/features/**"],
                "message": "FSD: `entities` must not import from `features` (upper layer)."
              },
              {
                "group": ["@/widgets", "@/widgets/**"],
                "message": "FSD: `entities` must not import from `widgets` (upper layer)."
              },
              {
                "group": ["@/pages", "@/pages/**"],
                "message": "FSD: `entities` must not import from `pages` (upper layer)."
              },
              {
                "group": ["@/app", "@/app/**"],
                "message": "FSD: `entities` must not import from `app` (upper layer)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/widgets", "@/widgets/**"],
                "message": "FSD: `features` must not import from `widgets` (upper layer)."
              },
              {
                "group": ["@/pages", "@/pages/**"],
                "message": "FSD: `features` must not import from `pages` (upper layer)."
              },
              {
                "group": ["@/app", "@/app/**"],
                "message": "FSD: `features` must not import from `app` (upper layer)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/widgets/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/pages", "@/pages/**"],
                "message": "FSD: `widgets` must not import from `pages` (upper layer)."
              },
              {
                "group": ["@/app", "@/app/**"],
                "message": "FSD: `widgets` must not import from `app` (upper layer)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/pages/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/app", "@/app/**"],
                "message": "FSD: `pages` must not import from `app` (upper layer)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/app/routes/**/*.tsx"],
      "rules": {
        "react/only-export-components": [
          "warn",
          {
            "allowConstantExport": true,
            "allowExportNames": ["Route"]
          }
        ]
      }
    },
    {
      "files": ["src/shared/ui/shadcn/button.tsx", "src/shared/ui/shadcn/button-group.tsx"],
      "rules": {
        "react/only-export-components": "off"
      }
    },
    {
      "files": ["src/widgets/track-table/track-table.tsx"],
      "rules": {
        "react/incompatible-library": "off"
      }
    }
  ],
  "ignorePatterns": [
    "dist",
    "src/shared/ipc/bindings.ts",
    "out",
    "build",
    "node_modules",
    "playwright-report",
    "test-results",
    "release",
    "src/app/routeTree.gen.ts"
  ]
}
